.{
    .name = .rhi_examples,
    .version = "0.0.0",
    .fingerprint = 0xc7587d4836be1726, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // The core RHI library, consumed as a sibling path dependency.
        .rhi = .{ .path = ".." },
        .sdl = .{
            .url = "git+https://github.com/castholm/SDL.git#018241066ffdae90d8b11f8bdc6242202f0f5451",
            .hash = "sdl-0.5.1+3.4.10-SDL--kbMpgGMXke11Ujh5HUPKch7G_SUAS12LI0QFoqj",
            .lazy = true,
        },

        // Prebuilt Slang shader compiler (`slangc`), packaged under deps/slang.
        // It picks the archive matching the build host (all lazy, so only that
        // one downloads) and exposes `bin/slangc`, which `build.zig` runs to
        // compile the example `.slang` shaders. Override with
        // `-Dslangc=/path/to/slangc` to skip the download entirely.
        .slang = .{ .path = "../deps/slang", .lazy = true },
    },
    .paths = .{ "build.zig", "build.zig.zon", "example_assets" },
}
