.{
    .name = .slang,
    .version = "0.0.0",
    .fingerprint = 0x681d367cf088eecf,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Prebuilt Slang shader compiler (`slangc`), one archive per host
        // platform. Only the dependency matching the build host is fetched
        // (all are lazy); `build.zig` picks it and exposes `bin/slangc` so the
        // root build can compile the example `.slang` shaders. Override with
        // `-Dslangc=/path/to/slangc` (e.g. the Vulkan SDK's) to skip the
        // download entirely. Pinned to Slang v2026.11 — bump the URLs + hashes
        // together to upgrade.
        .slang_linux_x86_64 = .{
            .url = "https://github.com/shader-slang/slang/releases/download/v2026.11/slang-2026.11-linux-x86_64.tar.gz",
