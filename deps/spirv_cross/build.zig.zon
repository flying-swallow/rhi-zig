.{
    .name = .spirv_cross,
    .version = "0.0.0",
    .fingerprint = 0x7ea1d83e98c49c2, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // SPIRV-Cross, used only to translate the examples' SPIR-V into GLSL ES
        // 3.00 for the WebGL2 backend. Slang cannot emit GLSL ES itself.
        .spirv_cross = .{
            .url = "https://github.com/KhronosGroup/SPIRV-Cross/archive/refs/tags/vulkan-sdk-1.4.313.0.tar.gz",
            .hash = "N-V-__8AACSRsADEXGLn-NAHOCOWTL22cm8VNhoVwChesgv2",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "spirv_cross_tool.cpp",
    },
}
