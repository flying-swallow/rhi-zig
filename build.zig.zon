.{
    .name = .rhi,
    .version = "0.0.0",
    .fingerprint = 0x317e5d7f685d6ba3,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .vma = .{ .path = "deps/vma", .lazy = true },
        .metal = .{ .path = "deps/metal", .lazy = true },
        .slang = .{ .path = "deps/slang", .lazy = true },
        // Translates the examples' SPIR-V into GLSL ES 3.00 for the WebGL2
        // backend; Slang itself cannot emit an ES profile. Lazy, and only
        // resolved for a WebAssembly target (see build.zig).
        .spirv_cross = .{ .path = "deps/spirv_cross", .lazy = true },
        // Lazy + resolved only for a Windows target (see build.zig): it pulls a
        // glfw_zig/wayland_zig/toolbox chain that isn't needed off Windows and
        // breaks on newer zig nightlies (toolbox uses the deleted
        // std.Uri.getHostAlloc).
        .zwindows = .{
            .url = "git+https://github.com/flying-swallow/zwindows.git#a0bcb1ddf17fc4d458dff849a895644931a921df",
            .hash = "zwindows-0.3.0-dev-xMZ1u0OlEgBe5N8_vygzx_IOFwrKSJRkQvtjOyU4Qg60",
            .lazy = true,
        },
        .vulkan_headers = .{
            .url = "https://github.com/KhronosGroup/Vulkan-Headers/archive/v1.3.283.tar.gz",
            .hash = "N-V-__8AAAkkoQGn5z1yoNVrwqZfnYmZp8AZ5CJgoHRMQI0c",
        },
        .vulkan = .{
            .url = "git+https://github.com/flying-swallow/vulkan-zig.git#70947a9209eb4b5ecc580c1fd3d3717fa686074c",
            .hash = "vulkan-0.0.0-r7Ytx_6DAwDB1QJAbIew5IzR2PiiAtJENX5kdJHf449X",
        },
        .cimgui_zig = .{
            .url = "git+https://github.com/flying-swallow/cimgui.zig.git#4a85aa3a7c7bd825ad5e9b54fa531ca0cb70f3e0",
            .hash = "cimgui_zig-1.0.0-2XubkqQ3wgDetMzfITqi4Sjb5Ny8_u5-W-8TZgB8L2_5",
            .lazy = true,
        },
    },
    .paths = .{ "build.zig", "build.zig.zon", "src", "deps" },
}
